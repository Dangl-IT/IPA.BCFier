<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006;CS8632</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.GitHub" Version="7.0.0" />
    <PackageReference Include="Nuke.WebDocu" Version="7.0.0" />
    <PackageDownload Include="GitVersion.Tool" Version="[5.12.0]" />
    <PackageReference Include="Nuke.Common" Version="9.0.4" />
    <PackageReference Include="NSwag.CodeGeneration.TypeScript" Version="14.2.0" />
    <PackageReference Include="NSwag.MSBuild" Version="14.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageDownload Include="docfx" Version="[2.77.0]" />
    <PackageDownload Include="AzureSignTool" Version="[5.0.0]" />
    <PackageDownload Include="Tools.InnoSetup" Version="[6.2.2]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\IPA.BCFier\Models\**/*" LinkBase="Models" />
  </ItemGroup>
  
</Project>
